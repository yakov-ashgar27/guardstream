# Copy to backend/.env for running the backend outside Docker.
DATABASE_URL=postgresql+asyncpg://guardstream:guardstream@localhost:5432/guardstream
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# Detection tuning (defaults shown)
RULE_VELOCITY_POINTS=45
RULE_GEO_JUMP_POINTS=60
RULE_HIGH_AMOUNT_POINTS=35
RULE_HIGH_AMOUNT_THRESHOLD=3000
ML_WEIGHT=0.6
REVIEW_THRESHOLD=40
BLOCK_THRESHOLD=75

# Simulator
SIM_AUTOSTART=true
SIM_DEFAULT_TPS=4
SIM_DEFAULT_FRAUD_RATE=0.10
